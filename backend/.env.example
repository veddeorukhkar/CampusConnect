# Copy this file to ".env" and fill in your own values.
# NEVER share your real .env file publicly.

# Your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/campusconnect?retryWrites=true&w=majority

# Any long random string - used to sign login tokens
JWT_SECRET=replace_this_with_a_long_random_secret_key

# Port the server runs on
PORT=5000
